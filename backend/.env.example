# Automail backend — copy to .env and fill in. NEVER commit a real .env.

# Groq API key for the live LLM workflow (llama-3.3-70b-versatile).
# Without it, Automail runs in mock mode (rule-based + template drafts).
GROQ_API_KEY=

# Google Gemini API key — used for embeddings (Chroma RAG) in live mode.
# Without it, live mode falls back to the local keyword retriever.
GOOGLE_API_KEY=

# Mode: auto (live when GROQ_API_KEY is set, else mock) | mock | live
AUTOMAIL_MODE=auto

# Optional: Postgres DATABASE_URL for later (Supabase). SQLite is used
# when unset (backend/automail.db).
DATABASE_URL=

# Gmail credentials (live mode only). Point at the OAuth client JSON you
# download from Google Cloud Console. First run performs the OAuth flow
# and stores token.json next to it. NEVER commit credentials.json or
# token.json.
GMAIL_CREDENTIALS_PATH=

# Your own Gmail address — the workflow skips emails sent from it.
MY_EMAIL=
