# Mailroom backend — copy to .env and fill in. NEVER commit a real .env.
#
# Mailroom is REAL by default (live mode). It needs a Groq API key to run
# the email agents; without it the app starts but refuses to run with a
# clear setup message — nothing is faked.

# REQUIRED — Groq API key for the live LLM workflow (openai/gpt-oss-20b).
# Free at https://console.groq.com — no card needed.
GROQ_API_KEY=<redacted>

# OPTIONAL — Google Gemini API key for embeddings (Chroma vector RAG).
# Free at https://aistudio.google.com — without it, RAG uses the keyword
# retriever over your real knowledge base instead of vector search.
GOOGLE_API_KEY=<redacted>

# Mode: live (default, the real product) | mock (explicit demo only —
# seeded fake inbox, rule-based categorizer, template drafts).
MAILROOM_MODE=live

# DATABASE — Postgres (Supabase) when set, SQLite when unset.
# Local dev: leave unset — the app uses backend/mailroom.db.
# Vercel: REQUIRED — set it to your Supabase connection string
# (Project Settings → Database → Connection string, URI format).
# Without it, the serverless database resets on every cold start.
DATABASE_URL=<redacted>

# Gmail credentials (live mode).
# Local: point at the OAuth client JSON you download from Google Cloud
# Console (create a project, enable the Gmail API, create an OAuth
# client for a desktop app). First run performs the OAuth flow and
# stores token.json next to it. NEVER commit credentials.json or
# token.json.
GMAIL_CREDENTIALS_PATH=

# Vercel: there is no filesystem to upload credentials.json / token.json
# to, so pass their CONTENTS as env vars instead (base64 or raw JSON).
# Get them from your local backend/credentials.json and backend/token.json
# after a successful local OAuth run:
#   base64 -w0 backend/credentials.json   → GMAIL_CREDENTIALS_JSON
#   base64 -w0 backend/token.json         → GMAIL_TOKEN_JSON
# The token is a testing-mode OAuth token: it expires after 7 days, so
# re-authorize locally and refresh GMAIL_TOKEN_JSON weekly.
GMAIL_CREDENTIALS_JSON=
GMAIL_TOKEN_JSON=

# Your own Gmail address — the workflow skips emails sent from it.
MY_EMAIL=
